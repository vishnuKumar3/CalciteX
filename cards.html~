<!doctype html>
<style>
body,html{height:100%;}
#card{width:28%;height:65%;margin-top:5%;border-radius:10px;transition:1s;}
#card-front{border-radius:10px;background:linear-gradient(130deg,#00fb 25%,#0f05);display:flex;width:100%;height:100%;flex-direction:column;justify-content:flex-end;align-items:center;}
#card-front p{font-size:30px;color:black;opacity:0;animation:zoom 2s;animation-fill-mode:both;}

#card-back{overflow:hidden;border-radius:10px;opacity:1;width:100%;height:100%;border:1px solid #aaa;}
#card-back img{width:100%;height:50%;border-radius:10px 10px 0px 0px;opacity:0;animation:zoom 2s;animation-fill-mode:both;}
#card-content{display:flex;flex-direction:column;justify-content:space-around;width:94%;height:40%;margin:0% 3% 3% 3%;}
#card-back #card-content p:nth-child(1){font-size:30px;color:black;opacity:0;animation:zoom 2s;animation-fill-mode:both;}
#card-back #card-content p:nth-child(2){opacity:0;animation:zoom 2s;margin-top:-5%;animation-fill-mode:both;font-size:17px;line-height:25px;text-indent:10%;}
#card-back #card-content a{transition:1s;text-decoration:none;opacity:0;animation:zoom 2s;animation-fill-mode:both;}

#card-back a:hover{margin-left:2%;transition:1s;}

@keyframes zoom{from{opacity:0;} to{opacity:1;}}
@keyframes widthAnim{from{width:0%;} to{width:95%;}}

#card-back{display:none;}
#card:hover{transform:rotateY(180deg);transition:1s;}
#card:hover #card-front{display:none;}
#card:hover #card-back{display:block;transform:rotateY(-180deg);}

@media only screen and (min-width:1500px){
#card{height:50%;width:25%;}
}
</style>

